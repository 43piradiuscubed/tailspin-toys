---
import { clampRating, formatRatingText, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    showRatingOutOfFive?: boolean;
}

const { rating, showRatingOutOfFive = false } = Astro.props;
---

{showRatingOutOfFive ? (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            {rating !== null && (
                <span class="text-yellow-400">{formatStarRating(rating)}</span>
            )}
            {formatRatingText(rating)}
        </span>
    </div>
) : rating !== null && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            <span class="text-yellow-400">{formatStarRating(rating)}</span>
            {clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
